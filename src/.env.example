# Copy this file to src/.env and fill in your values. NEVER commit src/.env (it is in .gitignore).

# ── IBM watsonx.ai (Granite LLM: second opinion for low-confidence FIRs + station briefs) ───────────
# Optional: without these the system still runs; low-confidence FIRs go to the officer review queue
# and station briefs use a template. Create an API key at cloud.ibm.com (IAM > API keys) and use the
# project id of a watsonx.ai project. Region URL examples: https://us-south.ml.cloud.ibm.com,
# https://eu-de.ml.cloud.ibm.com (Frankfurt).
WATSONX_API_KEY=your_ibm_cloud_api_key
WATSONX_PROJECT_ID=your_watsonx_project_id
WATSONX_URL=https://eu-de.ml.cloud.ibm.com

# ── Core API (all optional; defaults shown) ─────────────────────────────────────────────────────────
# CRIMEFIR_DATABASE_URL=sqlite:///var/crimefir.db      # any SQLAlchemy URL, e.g. postgresql+psycopg://...
# CRIMEFIR_MODEL_SERVICE_URL=http://127.0.0.1:8100
# CRIMEFIR_DECISION_MIN_CONFIDENCE=0.40                  # Laya answers below this go to the Granite LLM
# CRIMEFIR_LLM_MONTHLY_TOKEN_BUDGET=250000               # stay inside the watsonx Lite free quota
# CRIMEFIR_SOFT_LINK_MIN_SIMILARITY=0.97                 # pattern-only links (tuned on the dev split)
# CRIMEFIR_ENV=development                               # "production" disables /api/system/reset

# ── Frontend (src/frontend/.env.local) ──────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ── MCP server for IBM Bob (set in .bob/mcp.json) ───────────────────────────────────────────────────
# CRIMEFIR_API_URL=http://127.0.0.1:8000
